    "onboarding.flow.capture.voice.note.original_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "okay vielleicht ist der hook so: deine besten ideen entstehen nicht in einem leeren dokument, eher wenn du draussen laeufst und es schnell festhalten musst bevor es weg ist..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "okay maybe the hook is: your best ideas are not born in a blank doc, they happen when you are walking outside and you need to catch it before it disappears..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ok quiza el hook sea: tus mejores ideas no nacen en un documento en blanco, pasan cuando caminas afuera y tienes que atraparlas antes de que desaparezcan..."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ok peut-etre que le hook c est : tes meilleures idees ne naissent pas dans un document vide, elles arrivent quand tu marches dehors et que tu dois les attraper avant qu elles disparaissent..."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たぶんhookは、最高のアイデアは空白のドキュメントで生まれるんじゃなくて、外を歩いている時に出てきて、消える前に捕まえないといけない、みたいな..."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마 hook은 이런 거야: 최고의 아이디어는 빈 문서에서 생기는 게 아니라 밖을 걷다가 떠오르고, 사라지기 전에 붙잡아야 한다는 느낌..."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好像 hook 可以是：你最好的想法不是在空白文档里诞生的，而是在外面走路时突然冒出来，所以要在它消失前先抓住……"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好像 hook 可以是：你最好的想法不是在空白文件裡誕生的，而是在外面走路時突然冒出來，所以要在它消失前先抓住……"
          }
        }
      }
    },
