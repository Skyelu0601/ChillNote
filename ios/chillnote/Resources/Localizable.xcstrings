    "onboarding.flow.ai_skills.demo.humanizer.after.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht nur zum Notieren da. Wenn du Inhalte erstellst, hilft es dir, deine Ideen weiterzuentwickeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not just for taking notes. It helps you keep ideas moving when you are making content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sirve solo para tomar notas. Cuando creas contenido, te ayuda a seguir desarrollando tus ideas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas seulement un outil de prise de notes. Il vous aide à faire avancer vos idées lorsque vous créez du contenu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ただメモを取るだけのアプリではありません。コンテンツを作るとき、アイデアを次の形へ進める手助けをします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단순히 노트만 적는 앱이 아니에요. 콘텐츠를 만들 때 아이디어를 계속 발전시킬 수 있도록 도와줘요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不只是拿来记笔记。做内容时，它能帮你把想法继续往前推。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不只是拿來記筆記。做內容時，它能幫你把想法繼續往前推。"
          }
        }
      }
    },
