    "onboarding.flow.ai_skills.demo.hooks.direct.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass gute Ideen nicht länger in chaotischen Notizen untergehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop losing good ideas inside messy notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de perder buenas ideas entre notas desordenadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne laissez plus vos bonnes idées se perdre dans des notes en désordre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散らかったメモの中に、せっかくのアイデアを埋もれさせないで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋은 아이디어가 정리되지 않은 노트 속에 묻히게 두지 마세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别再让好想法丢在一堆乱笔记里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別再讓好想法丟在一堆亂筆記裡。"
          }
        }
      }
    },
