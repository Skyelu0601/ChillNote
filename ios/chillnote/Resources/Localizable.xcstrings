    "onboarding.flow.ai_skills.demo.caption.tiktok.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere das, wenn deine Notizen immer wieder zu Entwürfen werden, die du nie veröffentlichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save this if your notes keep turning into drafts you never post."
