    "home.rating_prompt.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir ChillScript gefaellt, gib uns gern eine Bewertung. Wenn nicht, sag uns bitte Bescheid."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you like ChillScript, please leave us a rating. If not, we would love to hear from you."
