    "onboarding.flow.ai_skills.demo.humanizer.before.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht nur eine Notiz-App. Es ist ein umfassendes System, das deinen kreativen Workflow verbessert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not just a note-taking app. It is a comprehensive system designed to enhance your creative workflow."
