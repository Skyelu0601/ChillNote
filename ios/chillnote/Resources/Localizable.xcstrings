    "onboarding.flow.ai_skills.demo.hooks.question.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was, wenn dein nächster Post schon in deinen Notizen steckt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What if your next post is already sitting in your notes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Y si tu próxima publicación ya está en tus notas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et si votre prochaine publication se trouvait déjà dans vos notes ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の投稿が、すでにメモの中にあるとしたら？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 게시물이 이미 노트 속에 있다면 어떨까요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的下一条内容，其实已经躺在笔记里了呢？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你的下一條內容，其實已經躺在筆記裡了呢？"
          }
        }
      }
    },
