            "state" : "translated",
            "value" : "계속하려면 두 단계를 모두 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看完两个步骤后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看完兩個步驟後繼續。"
