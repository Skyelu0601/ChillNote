    "about.workflow.ai.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass KI Transkripte bereinigen, Hooks erkennen, Notizen ordnen und aus Rohmaterial klare Ansaetze machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let AI clean transcripts, identify hooks, organize notes, and turn rough material into clear starting points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la IA limpie transcripciones, detecte hooks, organice notas y convierta material bruto en puntos de partida claros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez l IA nettoyer les transcriptions, identifier les hooks, organiser les notes et transformer la matiere brute en points de depart clairs."
