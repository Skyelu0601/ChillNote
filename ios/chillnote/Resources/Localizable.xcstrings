    "teleprompter.error.audio_session_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon konnte nicht vorbereitet werden. Die Aufnahme enthält möglicherweise keinen Ton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not prepare the microphone. Recording may not include audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo preparar el micrófono. Es posible que la grabación no tenga audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de préparer le micro. L’enregistrement pourrait ne pas contenir d’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクを準備できませんでした。録画に音声が含まれない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크를 준비할 수 없습니다. 녹화에 오디오가 포함되지 않을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备麦克风，录制可能没有声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法準備麥克風，錄製可能沒有聲音。"
          }
        }
      }
    },
