    "onboarding.flow.ai_skills.demo.repurpose.linkedin.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einer langen Notiz wird ein klarer, professioneller Beitrag, der die Kernaussage gleich zu Beginn nennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A long note becomes a clean professional post with the core insight up front."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota larga se convierte en una publicación profesional y clara, con la idea principal desde el principio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une longue note devient une publication professionnelle et claire, avec l’idée principale dès le début."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長いメモを、要点が冒頭で伝わる読みやすいプロ向け投稿に変えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 노트를 핵심 메시지가 첫머리에 드러나는 깔끔하고 전문적인 게시물로 바꿉니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一篇长笔记会变成结构清楚的职业向帖子，开头先给核心观点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一篇長筆記會變成結構清楚的職業向貼文，開頭先給核心觀點。"
          }
        }
      }
    },
