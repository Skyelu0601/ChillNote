    "about.section.4.body.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript behandelt gespeicherte Creator-Inspiration als Referenzmaterial, nicht als Text zum Kopieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript treats saved creator inspiration as reference material, not as copy to duplicate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript trata la inspiracion guardada como material de referencia, no como texto para duplicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript traite l inspiration sauvegardee comme une matiere de reference, pas comme un texte a dupliquer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScriptは保存したクリエイターのインスピレーションを、コピーする文章ではなく参考素材として扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript는 저장한 크리에이터 영감을 그대로 복제할 문장이 아니라 참고 자료로 다룹니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript 会把你保存的创作灵感当作参考素材，而不是拿来照搬的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChillScript 會把你保存的創作靈感當作參考素材，而不是拿來照搬的文字。"
          }
        }
      }
    },
    "about.section.4.body.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Der Unterschied:** Du baust ein Verstaendnis fuer Muster auf: warum ein Einstieg funktioniert, wie ein Skript Spannung haelt oder welche Sprache eine Zielgruppe bewegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**The Difference:** You build an understanding of patterns: why an opening works, how a script holds attention, or what language moves an audience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La diferencia:** Construyes una comprension de patrones: por que funciona una apertura, como un guion mantiene la atencion o que lenguaje mueve a una audiencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**La difference :** Vous construisez une comprehension des motifs : pourquoi une ouverture fonctionne, comment un script garde l attention ou quel langage touche une audience."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**違い:** 冒頭がなぜ機能するのか、台本がどう注意を保つのか、どんな言葉が視聴者を動かすのか。そうしたパターンへの理解を育てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**차이점:** 왜 시작이 통하는지, 스크립트가 어떻게 집중을 붙잡는지, 어떤 언어가 audience를 움직이는지 같은 패턴을 이해하게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**区别：** 你积累的是对模式的理解：为什么这个开头有效，脚本如何留住注意力，哪种语言能打动受众。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**差異：** 你累積的是對模式的理解：為什麼這個開頭有效，腳本如何留住注意力，哪種語言能打動受眾。"
          }
        }
      }
    },
    "about.section.4.body.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Das Ergebnis:** Deine AI Creator Notes bleiben privat, organisiert und hilfreich, damit du aus mehr Quellen lernen kannst, ohne deine eigene Stimme zu verlieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**The Result:** Your AI creator notes stay private, organized, and useful, so you can learn from more sources without losing your own voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**El resultado:** Tus notas de creador con IA se mantienen privadas, organizadas y utiles, para que puedas aprender de mas fuentes sin perder tu propia voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Le resultat :** Vos notes creator IA restent privees, organisees et utiles, afin d apprendre de plus de sources sans perdre votre propre voix."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**結果:** AIクリエイターノートはプライベートで整理された実用的な場所になり、自分の声を失わずにより多くの素材から学べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**결과:** AI 크리에이터 노트는 비공개로 정리되고 유용하게 유지되어, 나만의 목소리를 잃지 않으면서 더 많은 자료에서 배울 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**结果：** 你的 AI creator notes 会保持私密、有序、好用，让你能从更多来源学习，同时不丢掉自己的表达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**結果：** 你的 AI creator notes 會保持私密、有序、好用，讓你能從更多來源學習，同時不丟掉自己的表達。"
          }
        }
      }
    },
    "about.section.4.quote" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ich will nicht kopieren. Ich will lernen, was funktioniert.\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"I do not want to copy. I want to learn what works.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"No quiero copiar. Quiero aprender que funciona.\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Je ne veux pas copier. Je veux apprendre ce qui fonctionne.\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コピーしたいのではなく、何が効いているのか学びたい。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"베끼고 싶은 게 아니다. 무엇이 통하는지 배우고 싶다.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
