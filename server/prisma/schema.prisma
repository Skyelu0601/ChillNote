generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription Info
  subscriptionTier      String    @default("free") // "free" or "pro"
  subscriptionExpiresAt DateTime?
  subscriptionProvider  String?
  originalTransactionId String?   @unique // To link Apple receipt to User
  creemCustomerId       String?
  creemSubscriptionId   String?   @unique

  notes                  Note[]
  tags                   Tag[]
  linkImportJobs         LinkImportJob[]
  inviteCode             InviteCode?
  sentInvites            Invite[]                @relation("InviteInviter")
  receivedInvite         Invite?                 @relation("InviteInvitee")
  membershipGrants       MembershipGrantLedger[]
  credits                UserCredits?
  pushDevices            PushDevice[]
  notificationDeliveries NotificationDelivery[]
  weeklyTopicSettings    WeeklyTopicSettings?
  weeklyTopicReports     WeeklyTopicReport[]
}

model Note {
  id                     String          @id
  userId                 String
  content                String
  createdAt              DateTime
  updatedAt              DateTime
  deletedAt              DateTime?
  pinnedAt               DateTime?
  version                Int             @default(1)
  serverUpdatedAt        DateTime        @default(now())
  serverDeletedAt        DateTime?
  lastModifiedByDeviceId String?
  sourceURL              String?
  sourceTitle            String?
  sourcePlatformID       String?
  sourcePlatformName     String?
  sourceHost             String?
  sourceAuthorName       String?
  sourceAuthorHandle     String?
  sourceCapturedAt       DateTime?
  section                String          @default("inbox")
  importStatus           String?
  importJobId            String?
  importErrorCode        String?
  importStartedAt        DateTime?
  importCompletedAt      DateTime?
  tags                   Tag[]
  linkImportJobs         LinkImportJob[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LinkImportJob {
  id                 String    @id
  userId             String
  noteId             String
  url                String
  status             String
  showDescription    Boolean   @default(true)
  showAuthor         Boolean   @default(true)
  showHook           Boolean   @default(true)
  showTranscript     Boolean   @default(true)
  errorCode          String?
  attempts           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  creditAuthorizedAt DateTime?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Tag {
  id                     String    @id
  userId                 String
  name                   String
  colorHex               String
  createdAt              DateTime
  updatedAt              DateTime
  lastUsedAt             DateTime?
  sortOrder              Int
  parentId               String?
  deletedAt              DateTime?
  version                Int       @default(1)
  serverUpdatedAt        DateTime  @default(now())
  serverDeletedAt        DateTime?
  lastModifiedByDeviceId String?

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Tag?   @relation("TagHierarchy", fields: [parentId], references: [id])
  children Tag[]  @relation("TagHierarchy")
  notes    Note[]

  @@index([userId])
}

model SyncLog {
  id              Int      @id @default(autoincrement())
  userId          String
  entityType      String
  entityId        String
  version         Int
  serverUpdatedAt DateTime
  operation       String

  @@index([userId, id])
  @@index([userId, entityType, entityId])
}

model HardDeleteTombstone {
  id         Int      @id @default(autoincrement())
  userId     String
  entityType String
  entityId   String
  deletedAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId, deletedAt])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  source    String? // e.g., "twitter", "website"
}

model InviteCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites Invite[]
}

model Invite {
  id           String    @id @default(cuid())
  inviterId    String
  inviteeId    String    @unique
  inviteCodeId String
  inviteCode   String
  status       String
  rewardDays   Int       @default(7)
  boundAt      DateTime  @default(now())
  rewardedAt   DateTime?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inviter       User                    @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee       User                    @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteCodeRef InviteCode              @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  grants        MembershipGrantLedger[]

  @@index([inviterId, rewardedAt])
  @@index([inviteCode])
}

model MembershipGrantLedger {
  id              Int       @id @default(autoincrement())
  userId          String
  inviteId        String
  role            String
  days            Int
  beforeTier      String
  beforeExpiresAt DateTime?
  afterTier       String
  afterExpiresAt  DateTime?
  createdAt       DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite Invite @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([inviteId, role])
  @@index([userId, createdAt])
}

model UserCredits {
  userId    String   @id
  balance   Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushDevice {
  id                  String   @id @default(uuid())
  userId              String
  token               String   @unique
  platform            String   @default("ios")
  environment         String
  locale              String   @default("en")
  timeZone            String   @default("UTC")
  authorizationStatus String?
  isActive            Boolean  @default(true)
  lastSeenAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model NotificationDelivery {
  id          String    @id @default(uuid())
  userId      String
  kind        String
  dedupeKey   String    @unique
  noteId      String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("scheduled")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId, kind])
}

model WeeklyTopicSettings {
  userId        String    @id
  enabled       Boolean   @default(false)
  weekday       Int       @default(1)
  hour          Int       @default(9)
  minute        Int       @default(0)
  timeZone      String    @default("UTC")
  locale        String    @default("en")
  lastPeriodEnd DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

model WeeklyTopicReport {
  id                String    @id @default(uuid())
  userId            String
  periodStart       DateTime
  periodEnd         DateTime
  sourceNoteCount   Int
  language          String
  topics            Json
  readAt            DateTime?
  regenerationCount Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodEnd])
  @@index([userId, periodEnd])
}
